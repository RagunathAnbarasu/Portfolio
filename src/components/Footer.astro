---
import { profile } from '../data/profile';
---
<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {new Date().getUTCFullYear()} {profile.name}</p>
    <p>Thoughtful engineering. Continuous learning.</p>
    <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--border); }
  .footer-inner { padding-block: 26px; display: flex; justify-content: space-between; align-items: center; gap: 20px; font-size: 12px; color: var(--muted); }
  p { margin: 0; } a { text-decoration: none; color: var(--ink); }
  @media (max-width: 650px) { .footer-inner { flex-wrap: wrap; } .footer-inner p:nth-child(2) { display: none; } }
</style>
