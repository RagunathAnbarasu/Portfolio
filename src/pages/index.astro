---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { profile, experience, capabilities, credentials, formatDate } from '../data/profile';
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section id="about" class="shell hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Platform engineering · Cloud native</p>
      <h1 id="intro-title">Senior DevOps<br /><em>Developer.</em></h1>
      <p class="hero-description">{profile.summary}</p>
      <div class="hero-actions"><a class="button primary" href="#projects">View selected work <Arrow /></a><a class="text-link" href="#contact">Contact <Arrow /></a></div>
      <p class="hero-location"><svg width="15" height="18" viewBox="0 0 20 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 9c0 5-7 12-7 12S3 14 3 9a7 7 0 1 1 14 0Z" /><circle cx="10" cy="9" r="2.5" /></svg>{profile.location}</p>
    </div>
    <div class="hero-art" role="img" aria-label="Engineering focus: build cloud platforms, ship reliable releases, and observe systems">
      <div class="art-topline"><span>THE ENGINEERING PRACTICE</span><span aria-hidden="true">↗</span></div>
      <div class="orbit" aria-hidden="true"><span class="orbit-inner"></span><span class="orbit-dot"></span></div>
      <div class="practice-list">
        <div><span class="practice-number">01</span><p>Build<span>Cloud platforms & infrastructure</span></p><span class="practice-arrow" aria-hidden="true">↗</span></div>
        <div><span class="practice-number">02</span><p>Ship<span>Automation & software delivery</span></p><span class="practice-arrow" aria-hidden="true">↗</span></div>
        <div><span class="practice-number">03</span><p>Observe<span>Telemetry & platform reliability</span></p><span class="practice-arrow" aria-hidden="true">↗</span></div>
      </div>
      <p class="art-caption">Good platforms make better work possible.</p>
    </div>
  </section>

  <div class="shell technology-strip" aria-label="Core technologies"><span>Built around</span><p>AWS <span aria-hidden="true">/</span> Azure <span aria-hidden="true">/</span> Kubernetes <span aria-hidden="true">/</span> Terraform <span aria-hidden="true">/</span> OpenTelemetry</p></div>

  <section id="projects" class="shell section" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / Selected impact</p><h2 id="work-title">Engineering that<br />makes a difference.</h2></div><p class="section-intro">A few outcomes from my work at OpenText. Less manual effort, clearer signals, and smoother delivery.</p></div>
    <div class="work-grid">
      {work.map((entry) => <a class="work-card" href={`/work/${entry.id}/`}>
        <div class="card-top"><span class="eyebrow">{entry.data.category}</span><span class="card-arrow"><Arrow /></span></div>
        <div class="card-metrics">{entry.data.metrics.map((metric) => <div><span class="metric-value">{metric.value}</span><span class="metric-label">{metric.label}</span></div>)}</div>
        <h3>{entry.data.title}</h3><p class="card-description">{entry.data.description}</p>
        <div class="card-bottom"><span>{entry.data.technologies.slice(0, 3).join(' · ')}</span><span class="read-story">Read summary <span aria-hidden="true">↗</span></span></div>
      </a>)}
    </div>
    <p class="section-note">Approximate results from my professional experience. Each summary identifies the role and period.</p>
  </section>

  <section id="experience" class="experience-band" aria-labelledby="experience-title">
    <div class="shell section experience-layout"><div class="experience-heading"><p class="eyebrow">02 / Experience</p><h2 id="experience-title">A career built<br />on curiosity.</h2><p class="section-intro">6+ years across software development, cloud infrastructure, and platform engineering.</p><a class="text-link" href={profile.linkedin}>More on LinkedIn <Arrow /></a></div>
      <div class="timeline">{experience.map((job, index) => <article class="job">
        <div class="job-heading"><p class="job-employer">{job.employer}</p>{index === 0 && <span class="current-role">Current role</span>}</div>
        <h3>{job.title}</h3><p class="job-meta">{job.start} – {job.end}<span aria-hidden="true"> · </span>{job.location}</p>
        <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      </article>)}</div>
    </div>
  </section>

  <section id="skills" class="shell section" aria-labelledby="skills-title">
    <div class="section-heading"><div><p class="eyebrow">03 / Capabilities</p><h2 id="skills-title">Across the<br />delivery lifecycle.</h2></div><p class="section-intro">Tools and practices from my professional experience, organized around the problems they help solve.</p></div>
    <div class="capability-grid">{capabilities.map((capability, index) => <article class="capability"><span class="capability-index" aria-hidden="true">0{index + 1}</span><h3>{capability.title}</h3><p>{capability.description}</p><ul class="tags" aria-label={`${capability.title} technologies`}>{capability.technologies.map((technology) => <li>{technology}</li>)}</ul></article>)}</div>
  </section>

  <section id="certifications" class="shell section credential-section" aria-labelledby="credential-title">
    <div class="section-heading"><div><p class="eyebrow">04 / Credentials</p><h2 id="credential-title">Always learning.<br />Independently verified.</h2></div><div><p class="section-intro">Linux Foundation certifications in Kubernetes, GitOps, and observability.</p><a class="text-link" href={profile.credly}>All credentials on Credly <Arrow /></a></div></div>
    <div class="credential-grid">{credentials.map((credential) => <article class="credential">
      <img src={credential.image} width="128" height="128" alt={`${credential.acronym} certification badge`} loading="lazy" decoding="async" />
      <p class="credential-acronym">{credential.acronym}</p><h3>{credential.name}</h3><p class="credential-issuer">The Linux Foundation</p>
      <dl><div><dt>Issued</dt><dd><time datetime={credential.issued}>{formatDate(credential.issued)}</time></dd></div><div><dt>Expires</dt><dd><time datetime={credential.expires}>{formatDate(credential.expires)}</time></dd></div></dl>
      <a class="text-link" href={`https://www.credly.com/badges/${credential.badgeId}`} aria-label={`Verify ${credential.acronym} on Credly`}>Verify credential <Arrow /></a>
    </article>)}</div>
    <p class="section-note">Professional experience is outlined above; additional courses and learning badges are available on Credly.</p>
  </section>

  <section id="background" class="shell section background-section" aria-labelledby="background-title">
    <div class="section-heading"><div><p class="eyebrow">05 / Beyond the platform</p><h2 id="background-title">Learning, research,<br />and community.</h2></div></div>
    <div class="background-grid">
      <article><p class="eyebrow">Education</p><h3>{profile.education.degree}</h3><p>{profile.education.field}<br />{profile.education.specialization}</p><p class="background-meta">{profile.education.school}, {profile.education.location}<br />{profile.education.dates}</p></article>
      <article><p class="eyebrow">Community</p><h3>IEEE Women in Engineering Ottawa</h3><p>Contributed as a webmaster, maintaining a responsive website and supporting community outreach. Helped organize WIEHACK613 and served as Ottawa section lead for IEEEXtreme 14.0.</p><a class="text-link" href="https://www.ieeeottawa.ca/2020/05/ieee-wie-ottawa-team-member-selected-to-serve-as-an-ambassador-for-ieeextreme-14-0-competition-for-the-ottawa-region/">Community contribution <Arrow /></a></article>
      <article><p class="eyebrow">Research</p><h3>Secure access for connected systems</h3><p>Coauthor of “{profile.publication.title}.”</p><p class="background-meta">{profile.publication.venue}</p><a class="text-link" href={profile.publication.url}>View publication <Arrow /></a></article>
    </div>
    <div id="testimonials" class="recommendations"><p>Good work is a team effort.</p><a class="text-link" href={`${profile.linkedin}#recommendations`}>Read recommendations on LinkedIn <Arrow /></a></div>
  </section>

  <section id="contact" class="contact-band" aria-labelledby="contact-title"><div class="shell contact-inner"><div><p class="eyebrow">06 / Let’s connect</p><h2 id="contact-title">Let’s build<br /><em>what’s next.</em></h2><p>Have a platform engineering, DevOps, or SRE opportunity in mind? I’d be happy to connect.</p></div><div class="contact-links"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Arrow /></a><div class="social-links"><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.credly}>Credly <span aria-hidden="true">↗</span></a></div><p>{profile.location}</p></div></div></section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 70px; padding-block: 90px 76px; }
  .hero h1 { font-size: clamp(3.6rem, 5.6vw, 5.1rem); letter-spacing: -.065em; line-height: 1.04; margin: 25px 0 26px; }
  .hero-description { max-width: 480px; font-size: 17px; line-height: 1.8; color: var(--muted); }
  .hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 32px; }
  .hero-location { display: flex; align-items: center; gap: 9px; margin-top: 38px; font-size: 12px; color: var(--muted); }
  .status-dot { display: inline-block; width: 7px; height: 7px; background: var(--accent); border-radius: 50%; margin-right: 6px; }
  .hero-art { align-self: stretch; display: flex; flex-direction: column; position: relative; overflow: hidden; background: #e5ece3; border: 1px solid #cfdbce; padding: 27px 30px; border-radius: 5px; min-height: 470px; }
  .art-topline { display: flex; justify-content: space-between; color: #435c4a; font-size: 10px; letter-spacing: .13em; z-index: 1; }
  .art-topline span:last-child { font-size: 21px; line-height: 1; }
  .orbit { position: absolute; top: -30px; right: -125px; width: 390px; height: 390px; border: 1px solid #b9cebc; border-radius: 50%; }
  .orbit-inner { position: absolute; inset: 48px; border: 1px solid #b9cebc; border-radius: 50%; }
  .orbit-dot { position: absolute; width: 12px; height: 12px; border-radius: 50%; top: 132px; left: 1px; background: var(--accent); }
  .practice-list { margin-top: auto; padding-top: 100px; position: relative; }
  .practice-list > div { display: flex; align-items: center; gap: 22px; padding: 19px 0; border-bottom: 1px solid #bdcdbd; }
  .practice-number { font-size: 11px; color: #4d6254; align-self: flex-start; margin-top: 8px; }
  .practice-list p { font-family: Georgia, serif; font-size: 35px; margin: 0; line-height: 1.1; }
  .practice-list p span { display: block; font-family: var(--sans); font-size: 11px; line-height: 1.5; color: #435c4a; margin-top: 7px; }
  .practice-arrow { margin-left: auto; font-size: 24px; }
  .art-caption { margin: 20px 0 0; color: #435c4a; font-size: 10px; }
  .technology-strip { display: flex; align-items: center; justify-content: space-between; gap: 22px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding-block: 22px; }
  .technology-strip > span { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); white-space: nowrap; }
  .technology-strip p { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 24px; font-size: 14px; margin: 0; }
  .technology-strip p span { color: #66766a; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .work-card { display: flex; flex-direction: column; padding: 30px; border: 1px solid var(--border); border-radius: 5px; background: var(--surface); text-decoration: none; transition: border-color .2s, transform .2s; }
  .work-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
  .card-arrow { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; }
  .card-metrics { display: flex; gap: 30px; padding-block: 27px; }
  .metric-value { display: block; font-size: 48px; color: var(--accent); font-family: Georgia, serif; letter-spacing: -.05em; line-height: 1.2; }
  .metric-label { font-size: 11px; color: var(--muted); display: block; margin-top: 6px; }
  .work-card h3 { font-size: 21px; font-weight: 550; line-height: 1.4; margin: 0 0 12px; letter-spacing: -.025em; }
  .card-description { font-size: 14px; color: var(--muted); margin: 0 0 25px; }
  .card-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; border-top: 1px solid var(--border); padding-top: 19px; margin-top: auto; font-size: 10px; }
  .card-bottom > span:first-child { color: var(--muted); }
  .read-story { font-weight: 600; white-space: nowrap; }
  .experience-band { background: #ebeee7; border-block: 1px solid var(--border); }
  .experience-layout { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; }
  .experience-heading .section-intro { margin-block: 24px; }
  .job { padding-bottom: 30px; margin-bottom: 30px; border-bottom: 1px solid var(--border); }
  .job:last-child { padding-bottom: 0; margin-bottom: 0; border-bottom: 0; }
  .job-heading { display: flex; align-items: center; gap: 20px; justify-content: space-between; }
  .job-employer { font-size: 13px; font-weight: 650; margin: 0 0 12px; }
  .current-role { font-size: 10px; color: var(--accent); border: 1px solid #b6cbbd; border-radius: 20px; padding: 3px 9px; white-space: nowrap; }
  .job h3 { font-size: 20px; font-weight: 500; letter-spacing: -.025em; margin: 0 0 8px; }
  .job-meta { font-size: 11px; color: var(--muted); margin: 0; }
  .job ul { color: var(--muted); font-size: 13px; line-height: 1.85; padding-left: 16px; margin: 18px 0 0; }
  .job li + li { margin-top: 9px; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 32px; row-gap: 40px; }
  .capability { padding-top: 22px; border-top: 1px solid var(--border); }
  .capability-index { color: var(--accent); font-size: 11px; }
  .capability h3 { font-size: 19px; font-weight: 550; margin: 15px 0 10px; letter-spacing: -.02em; }
  .capability p { font-size: 13px; color: var(--muted); margin-bottom: 18px; }
  .credential-section, .background-section { border-top: 1px solid var(--border); }
  .credential-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .credential { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: 5px; padding: 23px; }
  .credential img { width: 110px; height: 110px; object-fit: contain; margin-bottom: 16px; }
  .credential-acronym { font-size: 11px; color: var(--accent); letter-spacing: .08em; font-weight: 650; margin: 0 0 9px; }
  .credential h3 { font-size: 16px; font-weight: 550; line-height: 1.45; margin: 0 0 8px; }
  .credential-issuer { font-size: 11px; color: var(--muted); margin: 0; }
  .credential dl { font-size: 10px; border-top: 1px solid var(--border); padding-top: 16px; margin-block: 20px; margin-top: auto; }
  .credential h3 + .credential-issuer { margin-bottom: 22px; }
  .credential dl div { display: flex; justify-content: space-between; gap: 8px; }
  .credential dl div + div { margin-top: 6px; }
  .credential dt { color: var(--muted); } .credential dd { margin: 0; }
  .credential .text-link { font-size: 11px; }
  .background-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 38px; }
  .background-grid article { border-top: 1px solid var(--border); padding-top: 22px; }
  .background-grid h3 { font-size: 19px; font-weight: 500; line-height: 1.4; margin-block: 18px 14px; letter-spacing: -.02em; }
  .background-grid p:not(.eyebrow) { font-size: 13px; color: var(--muted); }
  .background-meta { font-size: 11px !important; }
  .background-grid .text-link { margin-top: 9px; font-size: 12px; }
  .recommendations { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 50px; padding-top: 24px; border-top: 1px solid var(--border); font-size: 13px; }
  .recommendations p { margin: 0; color: var(--muted); }
  .contact-band { background: var(--ink); color: var(--paper); }
  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 55px; padding-block: 80px; }
  .contact-inner .eyebrow { color: #bfcebd; } .contact-inner h2 { margin-block: 20px 25px; font-size: clamp(2.9rem, 5vw, 4.7rem); }
  .contact-inner em { color: #c0d8bc; }
  .contact-inner > div > p:not(.eyebrow) { color: #c5d0c6; font-size: 14px; max-width: 370px; }
  .contact-email { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding-block: 22px; border-bottom: 1px solid #536257; text-decoration: none; font-size: clamp(.85rem, 1.4vw, 1.05rem); overflow-wrap: anywhere; }
  .contact-email svg { flex-shrink: 0; }
  .social-links { display: flex; gap: 30px; padding-block: 24px; }
  .social-links a { font-size: 13px; text-decoration: none; display: flex; gap: 15px; }
  .contact-links > p { font-size: 11px !important; }
  @media (max-width: 960px) { .hero { gap: 35px; padding-block: 65px; } .hero-art { padding: 22px; } .technology-strip p { gap: 15px; font-size: 12px; } .experience-layout { gap: 40px; } .credential-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .capability-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .hero { grid-template-columns: 1fr; padding-block: 50px; gap: 40px; } .hero h1 { font-size: clamp(3.5rem, 12vw, 5rem); } .hero-description { font-size: 15px; } .hero-art { min-height: 360px; } .practice-list { padding-top: 45px; } .practice-list > div { padding-block: 15px; } .technology-strip { align-items: flex-start; } .technology-strip p { gap: 10px; font-size: 11px; } .work-grid { grid-template-columns: 1fr; } .work-card { padding: 25px; } .experience-layout { grid-template-columns: 1fr; gap: 35px; } .background-grid { grid-template-columns: 1fr; gap: 28px; } .contact-inner { grid-template-columns: 1fr; gap: 25px; padding-block: 60px; } .contact-email { font-size: 15px; } }
  @media (max-width: 440px) { .hero .eyebrow { font-size: 9px; } .hero-actions { gap: 20px; } .capability-grid { grid-template-columns: 1fr; row-gap: 28px; } .credential-grid { gap: 12px; } .credential { padding: 16px; } .credential img { width: 88px; height: 88px; } .credential h3 { font-size: 14px; } .credential dl div { flex-direction: column; gap: 0; } .card-metrics { gap: 22px; } .metric-value { font-size: 44px; } }
</style>
