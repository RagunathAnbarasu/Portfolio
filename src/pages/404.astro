---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found | Ragunath Anbarasu" description="This page could not be found. Explore Ragunath Anbarasu’s platform engineering and DevOps work." noindex>
  <section class="shell not-found"><p class="eyebrow">404 / Page not found</p><h1>A little off course.</h1><p>This page isn’t here. You can return to the homepage or explore my selected work.</p><a class="button primary" href="/">Back to home <Arrow /></a><a class="text-link" href="/#projects">View selected work <Arrow /></a></section>
</Base>
<style>.not-found { padding-block: 100px 140px; } h1 { font-size: clamp(3rem, 7vw, 5rem); letter-spacing: -.04em; margin-block: 25px; } p:not(.eyebrow) { color: var(--muted); max-width: 480px; margin-bottom: 30px; } .text-link { margin: 20px; }</style>
